# Copia este archivo como .env (cp .env.example .env) y cambia las claves. Nunca subas .env a git.

# Nombre del proyecto de Docker Compose (dos worktrees con nombres distintos conviven)
COMPOSE_PROJECT_NAME=manogg

# Nombre de la base de datos PostgreSQL
POSTGRES_DB=censo_arboreo
# Usuario de la base de datos
POSTGRES_USER=ambiental
# Contraseña de la base de datos (vive solo aquí)
POSTGRES_PASSWORD=cambia_esta_clave

# Host de la BD visto desde la API (nombre del servicio de compose)
DB_HOST=db
# Puerto de la BD dentro de la red de Docker
DB_PUERTO=5432
# Puerto de la BD publicado en tu PC
DB_PUERTO_HOST=5432
# Esquema de PostgreSQL donde viven las tablas del censo
DB_ESQUEMA=censo

# Clave secreta de Django (larga y única por entorno)
DJANGO_SECRET_KEY=cambia_esta_clave_larga
# Modo depuración de Django (true solo en desarrollo)
DJANGO_DEBUG=true
# Hosts que Django acepta, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes del front permitidos por CORS, separados por coma
CORS_ORIGENES_PERMITIDOS=http://localhost:5173

# Puerto de la API (dentro del contenedor y publicado en tu PC)
API_PUERTO=8000
# Zona horaria de los contenedores y de Django
TZ=America/Lima
